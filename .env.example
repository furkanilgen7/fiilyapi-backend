DATABASE_URL=postgresql+asyncpg://fiil:fiil@localhost:5433/fiil_erp
TEST_DATABASE_URL=postgresql+asyncpg://fiil:fiil@localhost:5433/fiil_erp_test
JWT_SECRET=change-me-in-production
ENVIRONMENT=development

# B3.5 üretim sağlamlaştırma (hepsi opsiyonel; dev varsayılanları güvenli)
# Veritabanı zaman aşımları (saniye)
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
# CORS izin listesi (virgülle ayrılmış origin'ler; boşsa CORS middleware eklenmez).
# Prod'da frontend origin'i: örn. https://fiilyapi-frontend-production.up.railway.app
CORS_ORIGINS=
# Login/refresh hız sınırı (slowapi biçimi, IP başına)
LOGIN_RATE_LIMIT=10/minute
REFRESH_RATE_LIMIT=20/minute
